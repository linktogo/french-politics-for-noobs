{
  "name": "french-politics-for-noobs",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "update:deputes": "node scripts/update-deputes-votes.mjs",
